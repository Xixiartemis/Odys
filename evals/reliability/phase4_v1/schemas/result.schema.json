    "claimed_complete": {"type":"boolean"}, "verified_completion": {"type":"boolean"}, "false_completion": {"type":"boolean"}, "failure_type": {"type":["string","null"]}, "recovery_required": {"type":"boolean"}, "recovery_attempted": {"type":"boolean"}, "recovery_success": {"type":"boolean"}, "repair_scope": {"type":["string","null"]}, "repair_attempts": {"type":"integer","minimum":0}, "replan_count": {"type":"integer","minimum":0}, "lost_work_units": {"type":["integer","string"]}, "duplicate_side_effect_count": {"type":"integer","minimum":0}, "tool_calls": {"type":"integer","minimum":0}, "model_calls": {"type":"integer","minimum":0}, "attempt_count": {"type":"integer","minimum":0}, "tokens_input": {"type":["integer","string"]}, "tokens_output": {"type":["integer","string"]}, "total_tokens": {"type":["integer","string"]}, "model_cost": {"anyOf":[{"type":"number","minimum":0},{"const":"NOT_MEASURED"}]}, "tool_cost": {"anyOf":[{"type":"number","minimum":0},{"const":"NOT_MEASURED"}]}, "wall_time_seconds": {"type":["number","string"]}, "human_intervention": {"type":"boolean"}, "validity": {"enum":["VALIDATED_PASS","VALIDATED_FAIL","INVALID_RUN"]}, "invalid_reason": {"type":["string","null"]}, "started_at": {"type":"string"}, "finished_at": {"type":"string"}
